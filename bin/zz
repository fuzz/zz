#!/usr/bin/env ruby
# frozen_string_literal: true

require 'zz'

# Thor is giving us issues, so handle the input text directly
if ARGV.size > 0
  text = ARGV.join(' ')
  config = Zz::Config.new
  note = Zz::Note.new(text, config)

  if note.save
    puts note.filepath
    exit 0
  else
    exit 1
  end
else
  # No arguments provided, use the CLI handler for stdin/editor
  exit Zz::CLI.start(ARGV) || 0
end
